{
  "name": "product-management-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "qunit --require tsx/cjs \"tests/**/*-test.ts\"",
    "test:e2e": "playwright install chromium chromium-headless-shell && playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "oxlint src tests e2e playwright.config.ts",
    "format": "prettier --write .",
    "lintStaged": "lint-staged",
    "prepare": "husky",
    "serve:ssr:product-management-web": "node dist/product-management-web/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.24",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/qunit": "^2.19.14",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.8.1",
    "qunit": "^2.26.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "oxlint --fix"
    ]
  }
}
